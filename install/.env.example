# 源码构建与安装包共用的配置模板；安装脚本生成配置，已有配置不覆盖。
# 持久化目录：WORK_DIR/maxkb-remove-duplicates/{postgres,ingestion,documents}。
# WORK_DIR 使用绝对路径，或相对于源码/安装包根目录的路径。
WORK_DIR=/opt

# 数据库服务名称（Compose 内部 DNS）。
DB_HOST=postgres
# 数据库端口。
DB_PORT=5432
# 数据库用户名。
DB_USER=postgres
# 数据库密码。
DB_PASSWORD=postgres123!@#
# 数据库名称。
DB_NAME=maxkbremove
DB_SSLMODE=prefer
# PostgreSQL shared cache; reserve additional container/host memory for connections and the OS.
# Applied when the PostgreSQL container is recreated; source runs do not change a remote PG server.
PG_SHARED_BUFFERS=2GB
ENCRYPTION_KEY=replace-with-fernet-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-characters
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
COOKIE_SECURE=false
WEB_PORT=8080

# Docker image tag; keep the same tag when exporting/loading images.
IMAGE_VERSION=v1.0.0
# 容器内文档目录固定为 /sources，对应上述 documents 目录。

# Matrix scan workspace budget (MiB), range 32-2048, excluding the rest of the application.
# The actual block size is automatically reduced to fit this budget.
SCAN_MEMORY_MB=2048
# Maximum native math-library threads, capped by available CPU cores.
SCAN_THREADS=4
# Optional disk directory for temporary vector snapshots; do not use a RAM-backed filesystem.
# Docker defaults to /data/ingestion/.scan-tmp; source runs otherwise use the OS temp directory.
# SCAN_TEMP_DIR=/absolute/path/to/scan-temp

# Initial scan estimates without history; measured compatible runs take precedence.
# Matrix baseline: 768 dimensions, 1024-row blocks, four math-library threads.
SCAN_ESTIMATE_VECTOR_ROWS_PER_SECOND=2000
SCAN_ESTIMATE_PARAGRAPHS_PER_SECOND=3000
SCAN_ESTIMATE_MATRIX_CELLS_PER_SECOND=40000000
SCAN_ESTIMATE_RESULT_ROWS_PER_SECOND=15000
# Assumed fraction of valid chunk pairs producing candidates, range 0-1.
SCAN_ESTIMATE_MATCH_RATIO=0.001

# Local source-code runs: omitted paths default to project/data/ingestion and /sources.
# Docker overrides the following container paths; persistent host paths are managed by WORK_DIR.
# INGESTION_DATA_DIR=/absolute/path/to/persistent/ingestion
# SOURCE_DIR=/absolute/path/to/documents
PARSE_WORKERS=1
SPLIT_WORKERS=2
IMPORT_WORKERS=5
MAX_BATCH_FILES=100
MAX_FILE_MB=200
MAX_BATCH_MB=20480
MAX_QUEUE_FILES=5000
